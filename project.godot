; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Project Arcane Tavern"
config/description="Vertical Slice foundation for a 3D, AI-driven tavern management & social simulation game (Godot 4.x). Godot is the single source of truth; AI output is advisory only and always passes through Godot-side rule validation."
run/main_scene="res://game/scenes/dev/dev_playground.tscn"
config/features=PackedStringArray("4.7")
config/icon="res://icon.svg"

[autoload]

EventBus="*res://game/scripts/core/event_bus.gd"
GameState="*res://game/scripts/core/game_state.gd"
DataRegistry="*res://game/scripts/core/data_registry.gd"
RuleValidator="*res://game/scripts/core/rule_validator.gd"
GameClock="*res://game/scripts/time/game_clock.gd"
DayManager="*res://game/scripts/tavern/day_manager.gd"
SaveManager="*res://game/scripts/save/save_manager.gd"
GameManager="*res://game/scripts/core/game_manager.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720

